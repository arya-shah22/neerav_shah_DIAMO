// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 2: CORE INFRASTRUCTURE TABLES (4)
// ═══════════════════════════════════════════════════════════════════════════════

/// Legal entity: Stores company-level identity, tax credentials,
/// bank details, and portal API keys.
model Company {
  id                  Int           @id @default(autoincrement()) @db.UnsignedInt
  companyName         String        @unique @map("company_name") @db.VarChar(150)
  companyCode         String        @unique @map("company_code") @db.VarChar(3)
  panNumber           String        @map("pan_number") @db.VarChar(10)
  gstinNumber         String?       @map("gstin_number") @db.VarChar(15)
  tanNumber           String?       @map("tan_number") @db.VarChar(10)
  udyamMsme           String?       @map("udyam_msme") @db.VarChar(30)
  iecCode             String?       @map("iec_code") @db.VarChar(15)
  gstEnabled          Boolean       @default(true) @map("gst_enabled")
  gstRegistrationDate DateTime?     @map("gst_registration_date") @db.Date
  businessType        String?       @map("business_type") @db.VarChar(50)
  status              CompanyStatus @default(ACTIVE)
  isDefault           Boolean       @default(false) @map("is_default")
  logoPath            String?       @map("logo_path") @db.LongText

  // Address
  addressLine1 String?  @map("address_line_1") @db.VarChar(255)
  addressLine2 String?  @map("address_line_2") @db.VarChar(255)
  city         String?  @db.VarChar(100)
  stateCode    String?  @map("state_code") @db.VarChar(2)
  pincode      String?  @db.VarChar(10)
  country      String?  @default("India") @db.VarChar(100)
  distanceKm   Decimal? @map("distance_km") @db.Decimal(8, 2)

  // Contact
  mobile  String? @db.VarChar(20)
  phone   String? @db.VarChar(20)
  email   String? @db.VarChar(255)
  website String? @db.VarChar(255)

  // Bank Details
  bankAccountNumber String? @map("bank_account_number") @db.VarChar(30)
  bankName          String? @map("bank_name") @db.VarChar(150)
  bankBranch        String? @map("bank_branch") @db.VarChar(150)
  bankIfsc          String? @map("bank_ifsc") @db.VarChar(11)
  bankSwift         String? @map("bank_swift") @db.VarChar(11)

  // Portal Credentials (encrypted at application level)
  ewayPortalUser String? @map("eway_portal_user") @db.VarChar(255)
  ewayPortalPass String? @map("eway_portal_pass") @db.VarChar(500)
  gstrPortalUser String? @map("gstr_portal_user") @db.VarChar(255)
  gstrPortalPass String? @map("gstr_portal_pass") @db.VarChar(500)

  // Audit
  createdBy Int?      @map("created_by") @db.UnsignedInt
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedBy Int?      @map("updated_by") @db.UnsignedInt
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedBy Int?      @map("deleted_by") @db.UnsignedInt
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)
  version   Int       @default(1) @db.UnsignedInt

  // Relations
  financialYears         FinancialYear[]
  accountGroups          AccountGroup[]
  accounts               Account[]
  qualities              Quality[]
  saleInvoices           SaleInvoice[]
  purchaseInvoices       PurchaseInvoice[]
  challanVouchers        ChallanVoucher[]
  journalVouchers        JournalVoucher[]
  cashBankVouchers       CashBankVoucher[]
  jobVouchers            JobVoucher[]
  generalLedgerEntries   GeneralLedgerEntry[]
  outstandingBills       OutstandingBill[]
  stockPackets           StockPacket[]
  voucherNumberConfigs   VoucherNumberConfig[]
  voucherNumberSequences VoucherNumberSequence[]
  systemSettings         SystemSetting[]
  printTemplates         PrintTemplate[]
  userCompanyAccess      UserCompanyAccess[]
  notificationRecords    NotificationRecord[]
  Loan                   Loan[]
  stockConversions       StockConversion[]
  exchangeRateLogs       ExchangeRateLog[]

  @@map("companies")
}

/// Accounting period with transaction lock dates, tax activation flags,
/// and year-end carry-forward controls.
model FinancialYear {
  id                      Int       @id @default(autoincrement()) @db.UnsignedInt
  companyId               Int       @map("company_id") @db.UnsignedInt
  fromDate                DateTime  @map("from_date") @db.Date
  toDate                  DateTime  @map("to_date") @db.Date
  isActive                Boolean   @default(false) @map("is_active")
  isClosed                Boolean   @default(false) @map("is_closed")
  lockTransactionUptoDate DateTime? @map("lock_transaction_upto_date") @db.Date
  gstActive               Boolean   @default(true) @map("gst_active")
  tcsActive               Boolean   @default(true) @map("tcs_active")
  accountEffect           Boolean   @default(true) @map("account_effect")

  // Audit
  createdBy Int?      @map("created_by") @db.UnsignedInt
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedBy Int?      @map("updated_by") @db.UnsignedInt
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedBy Int?      @map("deleted_by") @db.UnsignedInt
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)
  version   Int       @default(1) @db.UnsignedInt

  // Relations
  company                Company                 @relation(fields: [companyId], references: [id])
  saleInvoices           SaleInvoice[]
  purchaseInvoices       PurchaseInvoice[]
  challanVouchers        ChallanVoucher[]
  journalVouchers        JournalVoucher[]
  cashBankVouchers       CashBankVoucher[]
  jobVouchers            JobVoucher[]
  voucherNumberConfigs   VoucherNumberConfig[]
  voucherNumberSequences VoucherNumberSequence[]
  Loan                   Loan[]

  @@unique([companyId, fromDate, toDate], map: "UQ_financial_years_company_dates")
  @@index([companyId, isActive], map: "IX_financial_years_company_active")
  @@map("financial_years")
}

/// Indian state code reference lookup (01–37). Seed data table.
model StateCode {
  id        Int     @id @default(autoincrement()) @db.UnsignedInt
  stateCode String  @unique @map("state_code") @db.VarChar(2)
  stateName String  @map("state_name") @db.VarChar(100)
  isUt      Boolean @default(false) @map("is_ut")

  @@map("state_codes")
}

/// Harmonized System of Nomenclature code reference. Seed data table.
model HsnCode {
  id          Int     @id @default(autoincrement()) @db.UnsignedInt
  hsnCode     String  @unique @map("hsn_code") @db.VarChar(8)
  description String  @map("description") @db.VarChar(255)
  gstPct      Decimal @default(0.00) @map("gst_pct") @db.Decimal(5, 2)
  cessPct     Decimal @default(0.00) @map("cess_pct") @db.Decimal(5, 2)

  @@map("hsn_codes")
}

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 3: MASTER DATA TABLES (5)
// ═══════════════════════════════════════════════════════════════════════════════

/// Chart of accounts hierarchy. Self-referencing tree structure.
model AccountGroup {
  id            Int     @id @default(autoincrement()) @db.UnsignedInt
  companyId     Int     @map("company_id") @db.UnsignedInt
  groupName     String  @map("group_name") @db.VarChar(150)
  parentGroupId Int?    @map("parent_group_id") @db.UnsignedInt
  nature        String  @map("nature") @db.VarChar(30) // Assets, Liabilities, Income, Expense
  isGlobal      Boolean @default(false) @map("is_global")
  sortOrder     Int     @default(0) @map("sort_order") @db.UnsignedInt

  // Audit
  createdBy Int?      @map("created_by") @db.UnsignedInt
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedBy Int?      @map("updated_by") @db.UnsignedInt
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedBy Int?      @map("deleted_by") @db.UnsignedInt
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)
  version   Int       @default(1) @db.UnsignedInt

  // Relations
  company     Company        @relation(fields: [companyId], references: [id])
  parentGroup AccountGroup?  @relation("GroupHierarchy", fields: [parentGroupId], references: [id])
  childGroups AccountGroup[] @relation("GroupHierarchy")
  accounts    Account[]

  @@unique([companyId, groupName], map: "UQ_account_groups_company_name")
  @@index([companyId, parentGroupId], map: "IX_account_groups_company_parent")
  @@map("account_groups")
}

/// Unified master for all ledger accounts: Customers, Suppliers,
/// Banks, Brokers, Expense/Income heads.
model Account {
  id             Int           @id @default(autoincrement()) @db.UnsignedInt
  companyId      Int           @map("company_id") @db.UnsignedInt
  accountGroupId Int           @map("account_group_id") @db.UnsignedInt
  accountName    String        @map("account_name") @db.VarChar(150)
  printName      String?       @map("print_name") @db.VarChar(150)
  status         AccountStatus @default(ACTIVE)
  isBroker       Boolean       @default(false) @map("is_broker")

  // Tax & KYC
  gstinNumber String?     @map("gstin_number") @db.VarChar(15)
  panNumber   String?     @map("pan_number") @db.VarChar(10)
  gstRegType  GstRegType? @map("gst_reg_type")
  udyamMsme   String?     @map("udyam_msme") @db.VarChar(30)
  tdsLedgerId Int?        @map("tds_ledger_id") @db.UnsignedInt
  tdsPct      Decimal?    @map("tds_pct") @db.Decimal(5, 2)
  tcsPct      Decimal?    @map("tcs_pct") @db.Decimal(5, 2)
  gstPct      Decimal?    @map("gst_pct") @db.Decimal(5, 2)
  brokerId    Int?        @map("broker_id") @db.UnsignedInt

  // Credit Terms
  creditDays  Int     @default(0) @map("credit_days") @db.UnsignedInt
  creditLimit Decimal @default(0.00) @map("credit_limit") @db.Decimal(18, 2)

  // Address
  addressLine1 String? @map("address_line_1") @db.VarChar(255)
  addressLine2 String? @map("address_line_2") @db.VarChar(255)
  city         String? @db.VarChar(100)
  stateCode    String? @map("state_code") @db.VarChar(2)
  pincode      String? @db.VarChar(10)
  country      String? @default("India") @db.VarChar(100)

  // Contact
  mobile String? @db.VarChar(20)
  phone  String? @db.VarChar(20)
  email  String? @db.VarChar(255)

  // Bank Details
  bankAccountNumber String? @map("bank_account_number") @db.VarChar(30)
  bankName          String? @map("bank_name") @db.VarChar(150)
  bankBranch        String? @map("bank_branch") @db.VarChar(150)
  bankIfsc          String? @map("bank_ifsc") @db.VarChar(11)

  // Opening Balance
  openingBalanceAmount Decimal          @default(0.00) @map("opening_balance_amount") @db.Decimal(18, 2)
  openingBalanceType   DebitCreditType? @map("opening_balance_type")

  // Audit
  createdBy Int?      @map("created_by") @db.UnsignedInt
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedBy Int?      @map("updated_by") @db.UnsignedInt
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedBy Int?      @map("deleted_by") @db.UnsignedInt
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)
  version   Int       @default(1) @db.UnsignedInt

  // Relations
  company          Company        @relation(fields: [companyId], references: [id])
  accountGroup     AccountGroup   @relation(fields: [accountGroupId], references: [id])
  brokerProfile    BrokerProfile?
  broker           Account?       @relation("AccountBroker", fields: [brokerId], references: [id])
  referredAccounts Account[]      @relation("AccountBroker")

  // Transaction Relations (as customer/supplier/party)
  saleInvoicesAsCustomer     SaleInvoice[]        @relation("CustomerOnSale")
  saleInvoicesAsBroker       SaleInvoice[]        @relation("BrokerOnSale")
  purchaseInvoicesAsSupplier PurchaseInvoice[]    @relation("SupplierOnPurchase")
  purchaseInvoicesAsBroker   PurchaseInvoice[]    @relation("BrokerOnPurchase")
  challanVouchersAsParty     ChallanVoucher[]     @relation("PartyOnChallan")
  cashBankVouchersAsParty    CashBankVoucher[]    @relation("PartyOnCashBank")
  cashBankVouchersAsBank     CashBankVoucher[]    @relation("BankOnCashBank")
  journalVoucherLines        JournalVoucherLine[]
  jobVouchersAsParty         JobVoucher[]         @relation("PartyOnJob")
  jobVouchersAsSubcontractor JobVoucher[]         @relation("SubcontractorOnJob")
  generalLedgerEntries       GeneralLedgerEntry[]
  outstandingBills           OutstandingBill[]
  loansAsParty               Loan[]               @relation("LoanPartyRelation")
  loansAsCashBank            Loan[]               @relation("LoanCashRelation")
  loanRepaymentsAsCashBank   LoanRepayment[]

  @@unique([companyId, accountName], map: "UQ_accounts_company_name")
  @@index([companyId, status, isDeleted], map: "IX_accounts_company_status")
  @@index([companyId, accountGroupId], map: "IX_accounts_company_group")
  @@index([companyId, isBroker], map: "IX_accounts_company_broker")
  @@fulltext([accountName], map: "FT_accounts_name")
  @@map("accounts")
}

/// Broker-specific extension fields. One-to-one with Account (where is_broker = true).
model BrokerProfile {
  id           Int         @id @default(autoincrement()) @db.UnsignedInt
  accountId    Int         @unique @map("account_id") @db.UnsignedInt
  brokeragePct Decimal     @default(0.00) @map("brokerage_pct") @db.Decimal(5, 2)
  addLess      AddLessType @default(LESS) @map("add_less")
  tdsLedgerId  Int?        @map("tds_ledger_id") @db.UnsignedInt
  tdsPct       Decimal     @default(5.00) @map("tds_pct") @db.Decimal(5, 2)

  // Audit
  createdBy Int?      @map("created_by") @db.UnsignedInt
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedBy Int?      @map("updated_by") @db.UnsignedInt
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedBy Int?      @map("deleted_by") @db.UnsignedInt
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)
  version   Int       @default(1) @db.UnsignedInt

  // Relations
  account Account @relation(fields: [accountId], references: [id])

  @@map("broker_profiles")
}

/// Diamond grade catalog: classification, HSN, UQC, rates, stock levels.
model Quality {
  id                   Int           @id @default(autoincrement()) @db.UnsignedInt
  companyId            Int           @map("company_id") @db.UnsignedInt
  qualityName          String        @map("quality_name") @db.VarChar(100)
  hsnNumber            String        @map("hsn_number") @db.VarChar(8)
  uqc                  UqcType       @default(CTS)
  purchaseRate         Decimal       @default(0.00) @map("purchase_rate") @db.Decimal(18, 2)
  saleRate             Decimal       @default(0.00) @map("sale_rate") @db.Decimal(18, 2)
  mrp                  Decimal       @default(0.00) @db.Decimal(18, 2)
  minLevel             Decimal       @default(0.00) @map("min_level") @db.Decimal(12, 3)
  maxLevel             Decimal       @default(0.00) @map("max_level") @db.Decimal(12, 3)
  openingBalanceCarats Decimal       @default(0.000) @map("opening_balance_carats") @db.Decimal(12, 3)
  openingBalancePcs    Int           @default(0) @map("opening_balance_pcs") @db.UnsignedInt
  openingBalanceRate   Decimal       @default(0.00) @map("opening_balance_rate") @db.Decimal(18, 2)
  isService            Boolean       @default(false) @map("is_service")
  status               AccountStatus @default(ACTIVE)
  declarationText      String?       @map("declaration_text") @db.Text
  termsConditions      String?       @map("terms_conditions") @db.Text

  // Audit
  createdBy Int?      @map("created_by") @db.UnsignedInt
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedBy Int?      @map("updated_by") @db.UnsignedInt
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedBy Int?      @map("deleted_by") @db.UnsignedInt
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)
  version   Int       @default(1) @db.UnsignedInt

  // Relations
  company              Company               @relation(fields: [companyId], references: [id])
  gstHistory           QualityGstHistory[]
  saleInvoiceItems     SaleInvoiceItem[]
  purchaseInvoiceItems PurchaseInvoiceItem[]
  challanItems         ChallanItem[]
  jobVoucherItems      JobVoucherItem[]
  stockPackets                StockPacket[]
  conversionSourceQualities   StockConversion[]       @relation("ConversionSourceQuality")
  conversionOutputQualities   StockConversionOutput[] @relation("ConversionOutputQuality")

  @@unique([companyId, qualityName], map: "UQ_qualities_company_name")
  @@index([companyId, status, isDeleted], map: "IX_qualities_company_status")
  @@map("qualities")
}

/// Date-effective GST rate change history per Quality item.
model QualityGstHistory {
  id        Int      @id @default(autoincrement()) @db.UnsignedInt
  qualityId Int      @map("quality_id") @db.UnsignedInt
  applyDate DateTime @map("apply_date") @db.Date
  gstPct    Decimal  @map("gst_pct") @db.Decimal(5, 2)
  cessPct   Decimal  @default(0.00) @map("cess_pct") @db.Decimal(5, 2)
  remarks   String?  @db.VarChar(255)

  // Audit
  createdBy Int?     @map("created_by") @db.UnsignedInt
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedBy Int?     @map("updated_by") @db.UnsignedInt
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  // Relations
  quality Quality @relation(fields: [qualityId], references: [id])

  @@index([qualityId, applyDate], map: "IX_quality_gst_history_date")
  @@map("quality_gst_history")
}

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 4: TRANSACTION TABLES (12)
// ═══════════════════════════════════════════════════════════════════════════════

// ─── 4a. Sale Invoice ────────────────────────────────────────────────────────

/// Sale Book invoice header. Covers Sale Invoices, Sale Returns,
/// and Sale Debit Notes via the invoiceType discriminator.
model SaleInvoice {
  id              Int           @id @default(autoincrement()) @db.UnsignedInt
  companyId       Int           @map("company_id") @db.UnsignedInt
  financialYearId Int           @map("financial_year_id") @db.UnsignedInt
  invoiceType     InvoiceType   @default(SALE_INVOICE) @map("invoice_type")
  voucherNumber   String        @map("voucher_number") @db.VarChar(50)
  billNumber      String        @map("bill_number") @db.VarChar(50)
  invoiceDate     DateTime      @map("invoice_date") @db.Date
  dueDate         DateTime?     @map("due_date") @db.Date
  status          InvoiceStatus @default(DRAFT)
  paymentStatus   PaymentStatus @default(UNPAID) @map("payment_status")

  // Party
  customerId        Int     @map("customer_id") @db.UnsignedInt
  customerGstin     String? @map("customer_gstin") @db.VarChar(15)
  customerStateCode String? @map("customer_state_code") @db.VarChar(2)
  placeOfSupply     String? @map("place_of_supply") @db.VarChar(2)

  // Broker
  brokerId        Int?    @map("broker_id") @db.UnsignedInt
  brokeragePct    Decimal @default(0.00) @map("brokerage_pct") @db.Decimal(5, 2)
  brokerageAmount Decimal @default(0.00) @map("brokerage_amount") @db.Decimal(18, 2)

  // Credit Terms
  creditDays Int @default(0) @map("credit_days") @db.UnsignedInt

  // Totals (denormalized for performance)
  totalCarats       Decimal @default(0.000) @map("total_carats") @db.Decimal(12, 3)
  totalPieces       Int     @default(0) @map("total_pieces") @db.UnsignedInt
  totalGrossAmount  Decimal @default(0.00) @map("total_gross_amount") @db.Decimal(18, 2)
  totalDiscount     Decimal @default(0.00) @map("total_discount") @db.Decimal(18, 2)
  totalCgst         Decimal @default(0.00) @map("total_cgst") @db.Decimal(18, 2)
  totalSgst         Decimal @default(0.00) @map("total_sgst") @db.Decimal(18, 2)
  totalIgst         Decimal @default(0.00) @map("total_igst") @db.Decimal(18, 2)
  totalCess         Decimal @default(0.00) @map("total_cess") @db.Decimal(18, 2)
  totalTcs          Decimal @default(0.00) @map("total_tcs") @db.Decimal(18, 2)
  tcsSection        String? @map("tcs_section") @db.VarChar(10)
  tcsRate           Decimal @default(0.00) @map("tcs_rate") @db.Decimal(5, 2)
  roundOff          Decimal @default(0.00) @map("round_off") @db.Decimal(18, 2)
  netAmount         Decimal @default(0.00) @map("net_amount") @db.Decimal(18, 2)
  jamaAmount        Decimal @default(0.00) @map("jama_amount") @db.Decimal(18, 2)
  outstandingAmount Decimal @default(0.00) @map("outstanding_amount") @db.Decimal(18, 2)

  // Currency
  transactionCurrency CurrencyCode @default(INR) @map("transaction_currency")
  exchangeRate        Decimal      @default(1.0000) @map("exchange_rate") @db.Decimal(12, 4)
  netAmountAlt        Decimal      @default(0.00) @map("net_amount_alt") @db.Decimal(18, 2)

  // Reference (for Returns / Debit Notes)
  referenceInvoiceId  Int?    @map("reference_invoice_id") @db.UnsignedInt
  referenceBillNumber String? @map("reference_bill_number") @db.VarChar(50)
  challanVoucherId    Int?    @map("challan_voucher_id") @db.UnsignedInt

  // Narration
  narration String? @db.Text

  // Audit
  createdBy Int?      @map("created_by") @db.UnsignedInt
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedBy Int?      @map("updated_by") @db.UnsignedInt
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedBy Int?      @map("deleted_by") @db.UnsignedInt
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)
  version   Int       @default(1) @db.UnsignedInt

  // Relations
  company          Company           @relation(fields: [companyId], references: [id])
  financialYear    FinancialYear     @relation(fields: [financialYearId], references: [id])
  customer         Account           @relation("CustomerOnSale", fields: [customerId], references: [id])
  broker           Account?          @relation("BrokerOnSale", fields: [brokerId], references: [id])
  referenceInvoice SaleInvoice?      @relation("SaleInvoiceRef", fields: [referenceInvoiceId], references: [id])
  referencedBy     SaleInvoice[]     @relation("SaleInvoiceRef")
  items            SaleInvoiceItem[]

  @@unique([companyId, financialYearId, billNumber], map: "UQ_sale_invoices_bill")
  @@index([companyId, invoiceDate], map: "IX_sale_invoices_company_date")
  @@index([companyId, customerId, status], map: "IX_sale_invoices_customer")
  @@index([companyId, paymentStatus], map: "IX_sale_invoices_payment")
  @@index([companyId, invoiceType], map: "IX_sale_invoices_type")
  @@map("sale_invoices")
}

/// Sale Book line items: quality, carats, rates, discounts, taxes.
model SaleInvoiceItem {
  id            Int     @id @default(autoincrement()) @db.UnsignedInt
  saleInvoiceId Int     @map("sale_invoice_id") @db.UnsignedInt
  rowNumber     Int     @map("row_number") @db.UnsignedInt
  qualityId     Int     @map("quality_id") @db.UnsignedInt
  hsnNumber     String  @map("hsn_number") @db.VarChar(8)
  carats        Decimal @map("carats") @db.Decimal(12, 3)
  pieces        Int     @default(1) @db.UnsignedInt
  rate          Decimal @map("rate") @db.Decimal(18, 2)
  discountPct   Decimal @default(0.00) @map("discount_pct") @db.Decimal(5, 2)
  lessPct       Decimal @default(0.00) @map("less_pct") @db.Decimal(5, 2)
  termsRate     Decimal @default(0.00) @map("terms_rate") @db.Decimal(18, 2)
  grossAmount   Decimal @default(0.00) @map("gross_amount") @db.Decimal(18, 2)
  gstPct        Decimal @default(0.00) @map("gst_pct") @db.Decimal(5, 2)
  cgstAmount    Decimal @default(0.00) @map("cgst_amount") @db.Decimal(18, 2)
  sgstAmount    Decimal @default(0.00) @map("sgst_amount") @db.Decimal(18, 2)
  igstAmount    Decimal @default(0.00) @map("igst_amount") @db.Decimal(18, 2)
  cessPct       Decimal @default(0.00) @map("cess_pct") @db.Decimal(5, 2)
  cessAmount    Decimal @default(0.00) @map("cess_amount") @db.Decimal(18, 2)
  netAmount      Decimal  @default(0.00) @map("net_amount") @db.Decimal(18, 2)
  rateAlt        Decimal? @map("rate_alt") @db.Decimal(18, 2)
  netAmountAlt   Decimal? @map("net_amount_alt") @db.Decimal(18, 2)
  targetSaleRate Decimal? @map("target_sale_rate") @db.Decimal(18, 2)
  stockPacketId  Int?     @map("stock_packet_id") @db.UnsignedInt

  // Relations
  saleInvoice SaleInvoice @relation(fields: [saleInvoiceId], references: [id])
  quality     Quality     @relation(fields: [qualityId], references: [id])

  @@index([saleInvoiceId], map: "IX_sale_invoice_items_invoice")
  @@index([qualityId], map: "IX_sale_invoice_items_quality")
  @@map("sale_invoice_items")
}

// ─── 4b. Purchase Invoice ────────────────────────────────────────────────────

/// Purchase Book invoice header. Covers Purchase Invoices, Purchase Returns,
/// and Purchase Debit Notes via the invoiceType discriminator.
model PurchaseInvoice {
  id              Int           @id @default(autoincrement()) @db.UnsignedInt
  companyId       Int           @map("company_id") @db.UnsignedInt
  financialYearId Int           @map("financial_year_id") @db.UnsignedInt
  invoiceType     InvoiceType   @default(PURCHASE_INVOICE) @map("invoice_type")
  voucherNumber   String        @map("voucher_number") @db.VarChar(50)
  billNumber      String        @map("bill_number") @db.VarChar(50)
  invoiceDate     DateTime      @map("invoice_date") @db.Date
  dueDate         DateTime?     @map("due_date") @db.Date
  status          InvoiceStatus @default(DRAFT)
  paymentStatus   PaymentStatus @default(UNPAID) @map("payment_status")

  // Party
  supplierId        Int     @map("supplier_id") @db.UnsignedInt
  supplierGstin     String? @map("supplier_gstin") @db.VarChar(15)
  supplierStateCode String? @map("supplier_state_code") @db.VarChar(2)
  placeOfSupply     String? @map("place_of_supply") @db.VarChar(2)

  // Broker
  brokerId        Int?    @map("broker_id") @db.UnsignedInt
  brokeragePct    Decimal @default(0.00) @map("brokerage_pct") @db.Decimal(5, 2)
  brokerageAmount Decimal @default(0.00) @map("brokerage_amount") @db.Decimal(18, 2)

  // Credit Terms
  creditDays Int @default(0) @map("credit_days") @db.UnsignedInt

  // Totals (denormalized)
  totalCarats       Decimal @default(0.000) @map("total_carats") @db.Decimal(12, 3)
  totalPieces       Int     @default(0) @map("total_pieces") @db.UnsignedInt
  totalGrossAmount  Decimal @default(0.00) @map("total_gross_amount") @db.Decimal(18, 2)
  totalDiscount     Decimal @default(0.00) @map("total_discount") @db.Decimal(18, 2)
  totalCgst         Decimal @default(0.00) @map("total_cgst") @db.Decimal(18, 2)
  totalSgst         Decimal @default(0.00) @map("total_sgst") @db.Decimal(18, 2)
  totalIgst         Decimal @default(0.00) @map("total_igst") @db.Decimal(18, 2)
  totalCess         Decimal @default(0.00) @map("total_cess") @db.Decimal(18, 2)
  totalTds          Decimal @default(0.00) @map("total_tds") @db.Decimal(18, 2)
  tdsSection        String? @map("tds_section") @db.VarChar(10)
  tdsRate           Decimal @default(0.00) @map("tds_rate") @db.Decimal(5, 2)
  roundOff          Decimal @default(0.00) @map("round_off") @db.Decimal(18, 2)
  netAmount         Decimal @default(0.00) @map("net_amount") @db.Decimal(18, 2)
  jamaAmount        Decimal @default(0.00) @map("jama_amount") @db.Decimal(18, 2)
  outstandingAmount Decimal @default(0.00) @map("outstanding_amount") @db.Decimal(18, 2)

  // Currency
  transactionCurrency CurrencyCode @default(INR) @map("transaction_currency")
  exchangeRate        Decimal      @default(1.0000) @map("exchange_rate") @db.Decimal(12, 4)
  netAmountAlt        Decimal      @default(0.00) @map("net_amount_alt") @db.Decimal(18, 2)

  // Reference (for Returns / Debit Notes)
  referenceInvoiceId  Int?    @map("reference_invoice_id") @db.UnsignedInt
  referenceBillNumber String? @map("reference_bill_number") @db.VarChar(50)

  // Narration
  narration String? @db.Text

  // Audit
  createdBy Int?      @map("created_by") @db.UnsignedInt
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedBy Int?      @map("updated_by") @db.UnsignedInt
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedBy Int?      @map("deleted_by") @db.UnsignedInt
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)
  version   Int       @default(1) @db.UnsignedInt

  // Relations
  company          Company               @relation(fields: [companyId], references: [id])
  financialYear    FinancialYear         @relation(fields: [financialYearId], references: [id])
  supplier         Account               @relation("SupplierOnPurchase", fields: [supplierId], references: [id])
  broker           Account?              @relation("BrokerOnPurchase", fields: [brokerId], references: [id])
  referenceInvoice PurchaseInvoice?      @relation("PurchaseInvoiceRef", fields: [referenceInvoiceId], references: [id])
  referencedBy     PurchaseInvoice[]     @relation("PurchaseInvoiceRef")
  items            PurchaseInvoiceItem[]

  @@unique([companyId, financialYearId, billNumber], map: "UQ_purchase_invoices_bill")
  @@index([companyId, invoiceDate], map: "IX_purchase_invoices_company_date")
  @@index([companyId, supplierId, status], map: "IX_purchase_invoices_supplier")
  @@index([companyId, paymentStatus], map: "IX_purchase_invoices_payment")
  @@map("purchase_invoices")
}

/// Purchase Book line items.
model PurchaseInvoiceItem {
  id                Int     @id @default(autoincrement()) @db.UnsignedInt
  purchaseInvoiceId Int     @map("purchase_invoice_id") @db.UnsignedInt
  rowNumber         Int     @map("row_number") @db.UnsignedInt
  qualityId         Int     @map("quality_id") @db.UnsignedInt
  hsnNumber         String  @map("hsn_number") @db.VarChar(8)
  carats            Decimal @map("carats") @db.Decimal(12, 3)
  pieces            Int     @default(1) @db.UnsignedInt
  rate              Decimal  @map("rate") @db.Decimal(18, 2)
  targetSaleRate    Decimal? @map("target_sale_rate") @db.Decimal(18, 2)
  discountPct       Decimal @default(0.00) @map("discount_pct") @db.Decimal(5, 2)
  lessPct           Decimal @default(0.00) @map("less_pct") @db.Decimal(5, 2)
  termsRate         Decimal @default(0.00) @map("terms_rate") @db.Decimal(18, 2)
  grossAmount       Decimal @default(0.00) @map("gross_amount") @db.Decimal(18, 2)
  gstPct            Decimal @default(0.00) @map("gst_pct") @db.Decimal(5, 2)
  cgstAmount        Decimal @default(0.00) @map("cgst_amount") @db.Decimal(18, 2)
  sgstAmount        Decimal @default(0.00) @map("sgst_amount") @db.Decimal(18, 2)
  igstAmount        Decimal @default(0.00) @map("igst_amount") @db.Decimal(18, 2)
  cessPct           Decimal @default(0.00) @map("cess_pct") @db.Decimal(5, 2)
  cessAmount        Decimal @default(0.00) @map("cess_amount") @db.Decimal(18, 2)
  netAmount         Decimal @default(0.00) @map("net_amount") @db.Decimal(18, 2)
  rateAlt           Decimal? @map("rate_alt") @db.Decimal(18, 2)
  netAmountAlt      Decimal? @map("net_amount_alt") @db.Decimal(18, 2)
  stockPacketId     Int?    @map("stock_packet_id") @db.UnsignedInt

  // Relations
  purchaseInvoice PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id])
  quality         Quality         @relation(fields: [qualityId], references: [id])

  @@index([purchaseInvoiceId], map: "IX_purchase_invoice_items_invoice")
  @@index([qualityId], map: "IX_purchase_invoice_items_quality")
  @@map("purchase_invoice_items")
}

// ─── 4c. Challan Voucher ─────────────────────────────────────────────────────

/// Challan header for all purposes: Jhanghad, Job Work, Lab, Orders, Transfers.
model ChallanVoucher {
  id              Int            @id @default(autoincrement()) @db.UnsignedInt
  companyId       Int            @map("company_id") @db.UnsignedInt
  financialYearId Int            @map("financial_year_id") @db.UnsignedInt
  purpose         ChallanPurpose @map("purpose")
  voucherNumber   String         @map("voucher_number") @db.VarChar(50)
  challanNumber   String         @map("challan_number") @db.VarChar(50)
  challanDate     DateTime       @map("challan_date") @db.Date
  status          ChallanStatus  @default(DRAFT)

  // Party / Custodian
  partyId   Int     @map("party_id") @db.UnsignedInt
  partyName String? @map("party_name") @db.VarChar(150)

  // Dates
  expectedReturnDate DateTime? @map("expected_return_date") @db.Date
  actualReturnDate   DateTime? @map("actual_return_date") @db.Date

  // Totals (denormalized)
  totalCarats    Decimal @default(0.000) @map("total_carats") @db.Decimal(12, 3)
  totalPieces    Int     @default(0) @map("total_pieces") @db.UnsignedInt
  totalAmount    Decimal @default(0.00) @map("total_amount") @db.Decimal(18, 2)
  returnedCarats Decimal @default(0.000) @map("returned_carats") @db.Decimal(12, 3)
  returnedPieces Int     @default(0) @map("returned_pieces") @db.UnsignedInt

  // Currency
  transactionCurrency CurrencyCode @default(INR) @map("transaction_currency")
  exchangeRate        Decimal      @default(1.0000) @map("exchange_rate") @db.Decimal(12, 4)
  totalAmountAlt      Decimal      @default(0.00) @map("total_amount_alt") @db.Decimal(18, 2)

  // Conversion Reference
  convertedInvoiceType String? @map("converted_invoice_type") @db.VarChar(30)
  convertedInvoiceId   Int?    @map("converted_invoice_id") @db.UnsignedInt

  // Narration
  narration String? @db.Text

  // Audit
  createdBy Int?      @map("created_by") @db.UnsignedInt
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedBy Int?      @map("updated_by") @db.UnsignedInt
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedBy Int?      @map("deleted_by") @db.UnsignedInt
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)
  version   Int       @default(1) @db.UnsignedInt

  // Relations
  company           Company            @relation(fields: [companyId], references: [id])
  financialYear     FinancialYear      @relation(fields: [financialYearId], references: [id])
  party             Account            @relation("PartyOnChallan", fields: [partyId], references: [id])
  items             ChallanItem[]
  stockReservations StockReservation[]

  @@unique([companyId, financialYearId, challanNumber], map: "UQ_challan_vouchers_number")
  @@index([companyId, purpose, status], map: "IX_challan_vouchers_purpose_status")
  @@index([companyId, expectedReturnDate], map: "IX_challan_vouchers_return_date")
  @@index([companyId, partyId], map: "IX_challan_vouchers_party")
  @@map("challan_vouchers")
}

/// Challan line items.
model ChallanItem {
  id               Int     @id @default(autoincrement()) @db.UnsignedInt
  challanVoucherId Int     @map("challan_voucher_id") @db.UnsignedInt
  rowNumber        Int     @map("row_number") @db.UnsignedInt
  qualityId        Int     @map("quality_id") @db.UnsignedInt
  carats           Decimal @map("carats") @db.Decimal(12, 3)
  pieces           Int     @default(1) @db.UnsignedInt
  rate             Decimal @default(0.00) @map("rate") @db.Decimal(18, 2)
  amount           Decimal @default(0.00) @map("amount") @db.Decimal(18, 2)
  rateAlt          Decimal? @map("rate_alt") @db.Decimal(18, 2)
  amountAlt        Decimal? @map("amount_alt") @db.Decimal(18, 2)
  returnedCarats   Decimal @default(0.000) @map("returned_carats") @db.Decimal(12, 3)
  returnedPieces   Int     @default(0) @map("returned_pieces") @db.UnsignedInt
  stockPacketId    Int?    @map("stock_packet_id") @db.UnsignedInt
  remarks          String? @db.VarChar(255)

  // Relations
  challanVoucher ChallanVoucher @relation(fields: [challanVoucherId], references: [id])
  quality        Quality        @relation(fields: [qualityId], references: [id])

  @@index([challanVoucherId], map: "IX_challan_items_voucher")
  @@map("challan_items")
}

// ─── 4d. Journal Voucher ─────────────────────────────────────────────────────

/// Journal Voucher header for all journal types.
model JournalVoucher {
  id              Int           @id @default(autoincrement()) @db.UnsignedInt
  companyId       Int           @map("company_id") @db.UnsignedInt
  financialYearId Int           @map("financial_year_id") @db.UnsignedInt
  journalType     JournalType   @default(GENERAL) @map("journal_type")
  voucherNumber   String        @map("voucher_number") @db.VarChar(50)
  voucherDate     DateTime      @map("voucher_date") @db.Date
  status          VoucherStatus @default(DRAFT)
  totalDebit      Decimal       @default(0.00) @map("total_debit") @db.Decimal(18, 2)
  totalCredit     Decimal       @default(0.00) @map("total_credit") @db.Decimal(18, 2)
  narration       String?       @db.Text
  referenceId     String?       @map("reference_id") @db.VarChar(50)
  referenceType   String?       @map("reference_type") @db.VarChar(30)

  // Currency
  transactionCurrency CurrencyCode @default(INR) @map("transaction_currency")
  exchangeRate        Decimal      @default(1.0000) @map("exchange_rate") @db.Decimal(12, 4)

  // Audit
  createdBy Int?      @map("created_by") @db.UnsignedInt
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedBy Int?      @map("updated_by") @db.UnsignedInt
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedBy Int?      @map("deleted_by") @db.UnsignedInt
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)
  version   Int       @default(1) @db.UnsignedInt

  // Relations
  company       Company              @relation(fields: [companyId], references: [id])
  financialYear FinancialYear        @relation(fields: [financialYearId], references: [id])
  lines         JournalVoucherLine[]

  @@unique([companyId, financialYearId, voucherNumber], map: "UQ_journal_vouchers_number")
  @@index([companyId, voucherDate], map: "IX_journal_vouchers_date")
  @@map("journal_vouchers")
}

/// Journal Voucher debit/credit lines.
model JournalVoucherLine {
  id               Int             @id @default(autoincrement()) @db.UnsignedInt
  journalVoucherId Int             @map("journal_voucher_id") @db.UnsignedInt
  rowNumber        Int             @map("row_number") @db.UnsignedInt
  accountId        Int             @map("account_id") @db.UnsignedInt
  debitCreditType  DebitCreditType @map("debit_credit_type")
  amount           Decimal         @map("amount") @db.Decimal(18, 2)
  amountAlt        Decimal?        @map("amount_alt") @db.Decimal(18, 2)
  narration        String?         @db.VarChar(255)
  outstandingBillId Int?             @map("outstanding_bill_id") @db.UnsignedInt

  // Relations
  journalVoucher  JournalVoucher   @relation(fields: [journalVoucherId], references: [id])
  account         Account          @relation(fields: [accountId], references: [id])
  outstandingBill OutstandingBill? @relation(fields: [outstandingBillId], references: [id])

  @@index([journalVoucherId], map: "IX_journal_voucher_lines_voucher")
  @@index([accountId], map: "IX_journal_voucher_lines_account")
  @@index([outstandingBillId], map: "IX_journal_voucher_lines_bill")
  @@map("journal_voucher_lines")
}

// ─── 4e. Cash/Bank Voucher ───────────────────────────────────────────────────

/// Unified Cash + Bank voucher header.
model CashBankVoucher {
  id              Int           @id @default(autoincrement()) @db.UnsignedInt
  companyId       Int           @map("company_id") @db.UnsignedInt
  financialYearId Int           @map("financial_year_id") @db.UnsignedInt
  transactionType CashBankType  @map("transaction_type")
  voucherNumber   String        @map("voucher_number") @db.VarChar(50)
  manualVoucherNo String?       @map("manual_voucher_no") @db.VarChar(50)
  voucherDate     DateTime      @map("voucher_date") @db.Date
  status          VoucherStatus @default(DRAFT)

  // Party
  partyId Int @map("party_id") @db.UnsignedInt

  // Cash/Bank Account
  cashBankAccountId Int @map("cash_bank_account_id") @db.UnsignedInt

  // Payment Mode (Bank only)
  paymentMode    PaymentMode? @map("payment_mode")
  chequeNumber   String?      @map("cheque_number") @db.VarChar(20)
  chequeDate     DateTime?    @map("cheque_date") @db.Date
  utrNumber      String?      @map("utr_number") @db.VarChar(50)
  transactionRef String?      @map("transaction_ref") @db.VarChar(50)

  // Amount
  amount    Decimal @map("amount") @db.Decimal(18, 2)
  narration String? @db.Text

  // Currency
  transactionCurrency CurrencyCode @default(INR) @map("transaction_currency")
  exchangeRate        Decimal      @default(1.0000) @map("exchange_rate") @db.Decimal(12, 4)
  amountAlt           Decimal      @default(0.00) @map("amount_alt") @db.Decimal(18, 2)

  // Reference
  referenceBillNo String? @map("reference_bill_no") @db.VarChar(50)

  // Audit
  createdBy Int?      @map("created_by") @db.UnsignedInt
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedBy Int?      @map("updated_by") @db.UnsignedInt
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedBy Int?      @map("deleted_by") @db.UnsignedInt
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)
  version   Int       @default(1) @db.UnsignedInt

  // Relations
  company             Company              @relation(fields: [companyId], references: [id])
  financialYear       FinancialYear        @relation(fields: [financialYearId], references: [id])
  party               Account              @relation("PartyOnCashBank", fields: [partyId], references: [id])
  cashBankAccount     Account              @relation("BankOnCashBank", fields: [cashBankAccountId], references: [id])
  allocations         CashBankAllocation[]
  bankReconciliations BankReconciliation[]

  @@unique([companyId, financialYearId, voucherNumber], map: "UQ_cash_bank_vouchers_number")
  @@index([companyId, transactionType, voucherDate], map: "IX_cash_bank_vouchers_type_date")
  @@index([companyId, partyId], map: "IX_cash_bank_vouchers_party")
  @@map("cash_bank_vouchers")
}

/// Outstanding bill allocation lines per Cash/Bank payment.
model CashBankAllocation {
  id                Int     @id @default(autoincrement()) @db.UnsignedInt
  cashBankVoucherId Int     @map("cash_bank_voucher_id") @db.UnsignedInt
  outstandingBillId Int     @map("outstanding_bill_id") @db.UnsignedInt
  allocatedAmount   Decimal @map("allocated_amount") @db.Decimal(18, 2)

  // Relations
  cashBankVoucher CashBankVoucher @relation(fields: [cashBankVoucherId], references: [id])
  outstandingBill OutstandingBill @relation(fields: [outstandingBillId], references: [id])

  @@index([cashBankVoucherId], map: "IX_cash_bank_allocations_voucher")
  @@index([outstandingBillId], map: "IX_cash_bank_allocations_bill")
  @@map("cash_bank_allocations")
}

// ─── 4f. Job Voucher ─────────────────────────────────────────────────────────

/// Job Book header for Job Income / Job Expense.
model JobVoucher {
  id              Int           @id @default(autoincrement()) @db.UnsignedInt
  companyId       Int           @map("company_id") @db.UnsignedInt
  financialYearId Int           @map("financial_year_id") @db.UnsignedInt
  jobType         JobType       @map("job_type")
  voucherNumber   String        @map("voucher_number") @db.VarChar(50)
  billNumber      String        @map("bill_number") @db.VarChar(50)
  voucherDate     DateTime      @map("voucher_date") @db.Date
  status          VoucherStatus @default(DRAFT)

  // Party (Customer & Factory Subcontractor)
  partyId              Int  @map("party_id") @db.UnsignedInt
  subcontractorPartyId Int? @map("subcontractor_party_id") @db.UnsignedInt

  // Conversion & Service Details
  serviceType           String?  @map("service_type") @db.VarChar(50)
  inwardRoughCarats     Decimal? @default(0.000) @map("inward_rough_carats") @db.Decimal(12, 3)
  inwardPieceCount      Int?     @default(1) @map("inward_piece_count") @db.UnsignedInt
  outwardPolishedCarats Decimal? @map("outward_polished_carats") @db.Decimal(12, 3)
  outwardPieceCount     Int?     @map("outward_piece_count") @db.UnsignedInt

  // Financial Rates & Taxes
  clientBilledRate       Decimal? @default(0.00) @map("client_billed_rate") @db.Decimal(18, 2)
  contractorExpenseRate  Decimal? @default(0.00) @map("contractor_expense_rate") @db.Decimal(18, 2)
  contractorExpenseTotal Decimal? @default(0.00) @map("contractor_expense_total") @db.Decimal(18, 2)
  gstRate                Decimal? @default(0.00) @map("gst_rate") @db.Decimal(5, 2)
  cgstAmount             Decimal? @default(0.00) @map("cgst_amount") @db.Decimal(18, 2)
  sgstAmount             Decimal? @default(0.00) @map("sgst_amount") @db.Decimal(18, 2)
  igstAmount             Decimal? @default(0.00) @map("igst_amount") @db.Decimal(18, 2)
  netAmount              Decimal? @default(0.00) @map("net_amount") @db.Decimal(18, 2)

  // Totals & Fulfillment
  totalCarats         Decimal @default(0.000) @map("total_carats") @db.Decimal(12, 3)
  totalAmount         Decimal @default(0.00) @map("total_amount") @db.Decimal(18, 2)
  totalOutwardCarats  Decimal @default(0.000) @map("total_outward_carats") @db.Decimal(12, 3)
  totalOutwardPieces  Int     @default(0) @map("total_outward_pieces") @db.UnsignedInt
  isFullyCompleted    Boolean @default(false) @map("is_fully_completed")
  narration           String? @db.Text

  // Currency
  transactionCurrency CurrencyCode @default(INR) @map("transaction_currency")
  exchangeRate        Decimal      @default(1.0000) @map("exchange_rate") @db.Decimal(12, 4)
  totalAmountAlt      Decimal      @default(0.00) @map("total_amount_alt") @db.Decimal(18, 2)

  // Audit
  createdBy Int?      @map("created_by") @db.UnsignedInt
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedBy Int?      @map("updated_by") @db.UnsignedInt
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedBy Int?      @map("deleted_by") @db.UnsignedInt
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)
  version   Int       @default(1) @db.UnsignedInt

  // Relations
  company       Company          @relation(fields: [companyId], references: [id])
  financialYear FinancialYear    @relation(fields: [financialYearId], references: [id])
  party              Account          @relation("PartyOnJob", fields: [partyId], references: [id])
  subcontractorParty Account?         @relation("SubcontractorOnJob", fields: [subcontractorPartyId], references: [id])
  items              JobVoucherItem[]
  costEntries        JobCostEntry[]

  @@unique([companyId, financialYearId, billNumber], map: "UQ_job_vouchers_bill")
  @@index([companyId, voucherDate], map: "IX_job_vouchers_date")
  @@map("job_vouchers")
}

/// Job Book line items.
model JobVoucherItem {
  id            Int     @id @default(autoincrement()) @db.UnsignedInt
  jobVoucherId  Int     @map("job_voucher_id") @db.UnsignedInt
  rowNumber     Int     @map("row_number") @db.UnsignedInt
  qualityId     Int     @map("quality_id") @db.UnsignedInt
  carats        Decimal @map("carats") @db.Decimal(12, 3)
  pieces        Int     @default(1) @db.UnsignedInt
  rate          Decimal @default(0.00) @map("rate") @db.Decimal(18, 2)
  amount        Decimal @default(0.00) @map("amount") @db.Decimal(18, 2)
  rateAlt       Decimal? @map("rate_alt") @db.Decimal(18, 2)
  amountAlt     Decimal? @map("amount_alt") @db.Decimal(18, 2)
  stockPacketId Int?    @map("stock_packet_id") @db.UnsignedInt
  remarks       String? @db.VarChar(255)

  // Relations
  jobVoucher JobVoucher @relation(fields: [jobVoucherId], references: [id])
  quality    Quality    @relation(fields: [qualityId], references: [id])

  @@index([jobVoucherId], map: "IX_job_voucher_items_voucher")
  @@map("job_voucher_items")
}

/// Job cost capitalization records.
model JobCostEntry {
  id            Int      @id @default(autoincrement()) @db.UnsignedInt
  jobVoucherId  Int      @map("job_voucher_id") @db.UnsignedInt
  stockPacketId Int      @map("stock_packet_id") @db.UnsignedInt
  costType      String   @map("cost_type") @db.VarChar(50)
  amount        Decimal  @map("amount") @db.Decimal(18, 2)
  remarks       String?  @db.VarChar(255)
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(3)

  // Relations
  jobVoucher  JobVoucher  @relation(fields: [jobVoucherId], references: [id])
  stockPacket StockPacket @relation(fields: [stockPacketId], references: [id])

  @@index([jobVoucherId], map: "IX_job_cost_entries_voucher")
  @@index([stockPacketId], map: "IX_job_cost_entries_packet")
  @@map("job_cost_entries")
}

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 5: ACCOUNTING ENGINE TABLES (4)
// ═══════════════════════════════════════════════════════════════════════════════

/// Unified double-entry general ledger postings. Every transaction
/// generates balanced debit/credit rows in this table.
model GeneralLedgerEntry {
  id              Int             @id @default(autoincrement()) @db.UnsignedInt
  companyId       Int             @map("company_id") @db.UnsignedInt
  accountId       Int             @map("account_id") @db.UnsignedInt
  voucherDate     DateTime        @map("voucher_date") @db.Date
  debitCreditType DebitCreditType @map("debit_credit_type")
  amount          Decimal         @map("amount") @db.Decimal(18, 2)

  // Polymorphic Source
  sourceVoucherType VoucherType @map("source_voucher_type")
  sourceVoucherId   Int         @map("source_voucher_id") @db.UnsignedInt
  sourceBillNumber  String?     @map("source_bill_number") @db.VarChar(50)

  narration String? @db.VarChar(255)

  // Currency Tracking (GL always posts in INR; these track the original currency)
  originalCurrency CurrencyCode? @map("original_currency")
  originalAmount   Decimal?      @map("original_amount") @db.Decimal(18, 2)
  exchangeRate     Decimal?      @map("exchange_rate") @db.Decimal(12, 4)

  // Audit
  createdBy Int?     @map("created_by") @db.UnsignedInt
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  // Relations
  company Company @relation(fields: [companyId], references: [id])
  account Account @relation(fields: [accountId], references: [id])

  @@index([companyId, accountId, voucherDate], map: "IX_gl_entries_account_date")
  @@index([companyId, voucherDate], map: "IX_gl_entries_company_date")
  @@index([sourceVoucherType, sourceVoucherId], map: "IX_gl_entries_source")
  @@map("general_ledger_entries")
}

/// Bill-level outstanding tracking for receivables and payables.
model OutstandingBill {
  id                Int             @id @default(autoincrement()) @db.UnsignedInt
  companyId         Int             @map("company_id") @db.UnsignedInt
  accountId         Int             @map("account_id") @db.UnsignedInt
  billNumber        String          @map("bill_number") @db.VarChar(50)
  billDate          DateTime        @map("bill_date") @db.Date
  dueDate           DateTime?       @map("due_date") @db.Date
  billType          DebitCreditType @map("bill_type") // DEBIT = Receivable, CREDIT = Payable
  originalAmount    Decimal         @map("original_amount") @db.Decimal(18, 2)
  allocatedAmount   Decimal         @default(0.00) @map("allocated_amount") @db.Decimal(18, 2)
  outstandingAmount Decimal         @map("outstanding_amount") @db.Decimal(18, 2)
  status            PaymentStatus   @default(UNPAID)

  // Polymorphic Source
  sourceVoucherType VoucherType @map("source_voucher_type")
  sourceVoucherId   Int         @map("source_voucher_id") @db.UnsignedInt

  // Currency
  transactionCurrency CurrencyCode @default(INR) @map("transaction_currency")
  exchangeRate        Decimal      @default(1.0000) @map("exchange_rate") @db.Decimal(12, 4)
  originalAmountAlt   Decimal      @default(0.00) @map("original_amount_alt") @db.Decimal(18, 2)

  // Audit
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  // Relations
  company             Company              @relation(fields: [companyId], references: [id])
  account             Account              @relation(fields: [accountId], references: [id])
  allocations         CashBankAllocation[]
  journalVoucherLines JournalVoucherLine[]

  @@index([companyId, accountId, status], map: "IX_outstanding_bills_account")
  @@index([companyId, dueDate], map: "IX_outstanding_bills_due_date")
  @@index([sourceVoucherType, sourceVoucherId], map: "IX_outstanding_bills_source")
  @@map("outstanding_bills")
}

/// Bank Reconciliation Statement (BRS) matching records.
model BankReconciliation {
  id                  Int            @id @default(autoincrement()) @db.UnsignedInt
  cashBankVoucherId   Int            @map("cash_bank_voucher_id") @db.UnsignedInt
  matchStatus         BrsMatchStatus @default(UNMATCHED) @map("match_status")
  bankStatementDate   DateTime?      @map("bank_statement_date") @db.Date
  bankStatementRef    String?        @map("bank_statement_ref") @db.VarChar(50)
  bankStatementAmount Decimal?       @map("bank_statement_amount") @db.Decimal(18, 2)
  reconciledDate      DateTime?      @map("reconciled_date") @db.Date
  reconciledBy        Int?           @map("reconciled_by") @db.UnsignedInt
  remarks             String?        @db.VarChar(255)
  createdAt           DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.DateTime(3)

  // Relations
  cashBankVoucher CashBankVoucher @relation(fields: [cashBankVoucherId], references: [id])

  @@index([cashBankVoucherId], map: "IX_bank_reconciliations_voucher")
  @@index([matchStatus], map: "IX_bank_reconciliations_status")
  @@map("bank_reconciliations")
}

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 6: DIAMOND INVENTORY TABLES (5)
// ═══════════════════════════════════════════════════════════════════════════════

/// Individual diamond packet: master record with physical properties,
/// current status (denormalized), and certification details.
model StockPacket {
  id               Int           @id @default(autoincrement()) @db.UnsignedInt
  companyId        Int           @map("company_id") @db.UnsignedInt
  qualityId        Int           @map("quality_id") @db.UnsignedInt
  stockIdNumber    String        @map("stock_id_number") @db.VarChar(30)
  category         StockCategory @default(NON_CERTIFIED)
  registrationDate DateTime      @map("registration_date") @db.Date

  // Physical
  shape         String?  @db.VarChar(255)
  caratWeight   Decimal  @map("carat_weight") @db.Decimal(12, 3)
  pieceCount    Int      @default(1) @map("piece_count") @db.UnsignedInt
  color         String?  @db.VarChar(255)
  clarity       String?  @db.VarChar(255)
  cut           String?  @db.VarChar(255)
  polish        String?  @db.VarChar(255)
  symmetry      String?  @db.VarChar(255)
  lengthMm      Decimal? @map("length_mm") @db.Decimal(8, 2)
  widthMm       Decimal? @map("width_mm") @db.Decimal(8, 2)
  depthMm       Decimal? @map("depth_mm") @db.Decimal(8, 2)
  measurements  String?  @db.VarChar(255)
  totalDepthPct Decimal? @map("total_depth_pct") @db.Decimal(5, 2)
  tablePct      Decimal? @map("table_pct") @db.Decimal(5, 2)
  girdlePct     Decimal? @map("girdle_pct") @db.Decimal(5, 2)

  // Extended Diamond Details (VDB / Nivoda / RapNet)
  fluorescenceIntensity String?  @map("fluorescence_intensity") @db.VarChar(255)
  fluorescenceColor     String?  @map("fluorescence_color") @db.VarChar(255)
  rapPricePerCarat      Decimal? @map("rap_price_per_carat") @db.Decimal(18, 2)
  rapDiscountPct        Decimal? @map("rap_discount_pct") @db.Decimal(8, 2)
  crownAngle            Decimal? @map("crown_angle") @db.Decimal(5, 2)
  crownHeight           Decimal? @map("crown_height") @db.Decimal(5, 2)
  pavilionAngle         Decimal? @map("pavilion_angle") @db.Decimal(5, 2)
  pavilionDepth         Decimal? @map("pavilion_depth") @db.Decimal(5, 2)
  girdleMin             String?  @map("girdle_min") @db.VarChar(255)
  girdleMax             String?  @map("girdle_max") @db.VarChar(255)
  girdleCondition       String?  @map("girdle_condition") @db.VarChar(255)
  culetSize             String?  @map("culet_size") @db.VarChar(255)
  culetCondition        String?  @map("culet_condition") @db.VarChar(255)
  heartsAndArrows       String?  @map("hearts_and_arrows") @db.VarChar(255)
  eyeClean              String?  @map("eye_clean") @db.VarChar(255)
  shade                 String?  @map("shade") @db.VarChar(255)
  milky                 String?  @map("milky") @db.VarChar(255)
  treatment             String?  @map("treatment") @db.VarChar(255)
  tinge                 String?  @map("tinge") @db.VarChar(255)
  lustre                String?  @map("lustre") @db.VarChar(255)
  tableInclusion        String?  @map("table_inclusion") @db.VarChar(255)
  sideInclusion         String?  @map("side_inclusion") @db.VarChar(255)
  tableOpen             String?  @map("table_open") @db.VarChar(255)
  crownOpen             String?  @map("crown_open") @db.VarChar(255)
  girdleOpen            String?  @map("girdle_open") @db.VarChar(255)
  origin                String?  @map("origin") @db.VarChar(255)
  certificateUrl        String?  @map("certificate_url") @db.VarChar(255)
  webUrl                String?  @map("web_url") @db.VarChar(255)
  inscription           String?  @map("inscription") @db.VarChar(255)
  keyToSymbols          String?  @map("key_to_symbols") @db.VarChar(255)
  diamondComment        String?  @map("diamond_comment") @db.VarChar(255)
  fancyColor            String?  @map("fancy_color") @db.VarChar(255)
  fancyColorIntensity   String?  @map("fancy_color_intensity") @db.VarChar(255)
  fancyColorOvertone    String?  @map("fancy_color_overtone") @db.VarChar(255)

  // Additional Marketplace & Specialty Details
  availability           String?  @map("availability") @db.VarChar(255)
  city                   String?  @map("city") @db.VarChar(255)
  state                  String?  @map("state") @db.VarChar(255)
  tradeShow              String?  @map("trade_show") @db.VarChar(255)
  brand                  String?  @map("brand") @db.VarChar(255)
  sellerSpec             String?  @map("seller_spec") @db.VarChar(255)
  pairStockNumber        String?  @map("pair_stock_number") @db.VarChar(255)
  isPairSeparable        String?  @map("is_pair_separable") @db.VarChar(255)
  parcelStones           String?  @map("parcel_stones") @db.VarChar(255)
  reportFilename         String?  @map("report_filename") @db.VarChar(255)
  reportIssueDate        String?  @map("report_issue_date") @db.VarChar(255)
  labLocation            String?  @map("lab_location") @db.VarChar(255)
  certComment            String?  @map("cert_comment") @db.VarChar(500)
  memberComment          String?  @map("member_comment") @db.VarChar(500)
  allowRaplinkFeed       String?  @map("allow_raplink_feed") @db.VarChar(255)
  sarineLoupe            String?  @map("sarine_loupe") @db.VarChar(255)
  reportType             String?  @map("report_type") @db.VarChar(255)
  diamondType            String?  @map("diamond_type") @db.VarChar(255)
  blackInclusion         String?  @map("black_inclusion") @db.VarChar(255)
  whiteInclusion         String?  @map("white_inclusion") @db.VarChar(255)
  openInclusion          String?  @map("open_inclusion") @db.VarChar(255)
  starLength             Decimal? @map("star_length") @db.Decimal(5, 2)
  growthType             String?  @map("growth_type") @db.VarChar(255)
  bgm                    String?  @map("bgm") @db.VarChar(255)

  // Certification
  certificateType   String? @map("certificate_type") @db.VarChar(255)
  certificateNumber String? @map("certificate_number") @db.VarChar(191)

  // Valuation.
  // costPerCarat/totalCost hold the figure AS ENTERED, in costCurrency; the
  // *Inr columns hold the same value converted to base currency and are what
  // every report must read. Cost used to be stored with no currency marker at
  // all, so a USD purchase and an INR purchase landed in the same column and
  // valuation silently added dollars to rupees.
  costCurrency          CurrencyCode  @default(INR) @map("cost_currency")
  costExchangeRate      Decimal       @default(1.0000) @map("cost_exchange_rate") @db.Decimal(12, 4)
  costPerCarat          Decimal       @default(0.00) @map("cost_per_carat") @db.Decimal(18, 2)
  totalCost             Decimal       @default(0.00) @map("total_cost") @db.Decimal(18, 2)
  targetSaleRate        Decimal?      @map("target_sale_rate") @db.Decimal(18, 2)
  targetSaleRateCurrency CurrencyCode? @map("target_sale_rate_currency")
  costPerCaratInr       Decimal?      @map("cost_per_carat_inr") @db.Decimal(18, 2)
  totalCostInr          Decimal?      @map("total_cost_inr") @db.Decimal(18, 2)

  // Denormalized Status (updated by StockMovement events)
  currentStatus    StockStatus    @default(CREATED) @map("current_status")
  currentOwnership StockOwnership @default(COMPANY) @map("current_ownership")
  currentOwnerId   Int?           @map("current_owner_id") @db.UnsignedInt
  currentLocation  String?        @map("current_location") @db.VarChar(100)

  // Lineage / Origin Tracking
  sourcePacketId    Int?    @map("source_packet_id") @db.UnsignedInt
  sourceTransformId Int?    @map("source_transform_id") @db.UnsignedInt

  // Audit
  createdBy Int?      @map("created_by") @db.UnsignedInt
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedBy Int?      @map("updated_by") @db.UnsignedInt
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedBy Int?      @map("deleted_by") @db.UnsignedInt
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)
  version   Int       @default(1) @db.UnsignedInt

  // Relations
  company        Company            @relation(fields: [companyId], references: [id])
  quality        Quality            @relation(fields: [qualityId], references: [id])
  sourcePacket   StockPacket?       @relation("PacketLineage", fields: [sourcePacketId], references: [id])
  derivedPackets StockPacket[]      @relation("PacketLineage")
  movements      StockMovement[]
  reservations   StockReservation[]
  media          StockMedia[]
  jobCostEntries    JobCostEntry[]
  conversionSources StockConversion[]       @relation("ConversionSource")
  conversionOutputs StockConversionOutput[] @relation("ConversionOutput")

  @@unique([companyId, stockIdNumber], map: "UQ_stock_packets_id_number")
  @@unique([companyId, certificateNumber], map: "UQ_stock_packets_company_cert_number")
  @@index([companyId, currentStatus], map: "IX_stock_packets_status")
  // Prefix lengths keep this composite index within InnoDB's key-length limit.
  // Without them the four full VARCHAR(255) utf8mb4 columns total ~3064 bytes,
  // which MySQL 9.x / MariaDB reject (error 1071), leaving the schema half-built.
  @@index([companyId, shape(length: 50), color(length: 50), clarity(length: 30)], map: "IX_stock_packets_physical")
  @@index([companyId, caratWeight], map: "IX_stock_packets_weight")
  @@index([companyId, qualityId], map: "IX_stock_packets_quality")
  @@index([sourcePacketId], map: "IX_stock_packets_source")
  @@fulltext([stockIdNumber], map: "FT_stock_packets_id")
  @@map("stock_packets")
}

/// Lifecycle event log per stock packet. Append-only.
model StockMovement {
  id              Int          @id @default(autoincrement()) @db.UnsignedInt
  stockPacketId   Int          @map("stock_packet_id") @db.UnsignedInt
  movementDate    DateTime     @map("movement_date") @db.Date
  movementType    MovementType @map("movement_type")
  previousStatus  StockStatus  @map("previous_status")
  newStatus       StockStatus  @map("new_status")
  previousOwnerId Int?         @map("previous_owner_id") @db.UnsignedInt
  newOwnerId      Int?         @map("new_owner_id") @db.UnsignedInt
  carats          Decimal?     @db.Decimal(12, 3)
  pieces          Int?         @db.UnsignedInt

  // Polymorphic Source
  sourceVoucherType VoucherType? @map("source_voucher_type")
  sourceVoucherId   Int?         @map("source_voucher_id") @db.UnsignedInt

  remarks   String?  @db.VarChar(255)
  userId    Int?     @map("user_id") @db.UnsignedInt
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  // Relations
  stockPacket StockPacket @relation(fields: [stockPacketId], references: [id])

  @@index([stockPacketId, createdAt], map: "IX_stock_movements_packet_date")
  @@index([sourceVoucherType, sourceVoucherId], map: "IX_stock_movements_source")
  @@map("stock_movements")
}

/// Hold/allocation tracking per stock packet.
model StockReservation {
  id               Int       @id @default(autoincrement()) @db.UnsignedInt
  stockPacketId    Int       @map("stock_packet_id") @db.UnsignedInt
  challanVoucherId Int?      @map("challan_voucher_id") @db.UnsignedInt
  reservationType  String    @map("reservation_type") @db.VarChar(30) // HOLD, JOB_WORK, SALE_ORDER
  reservedCarats   Decimal   @map("reserved_carats") @db.Decimal(12, 3)
  reservedDate     DateTime  @map("reserved_date") @db.Date
  expiryDate       DateTime? @map("expiry_date") @db.Date
  isActive         Boolean   @default(true) @map("is_active")
  remarks          String?   @db.VarChar(255)
  createdAt        DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  // Relations
  stockPacket    StockPacket     @relation(fields: [stockPacketId], references: [id])
  challanVoucher ChallanVoucher? @relation(fields: [challanVoucherId], references: [id])

  @@index([stockPacketId, isActive], map: "IX_stock_reservations_active")
  @@map("stock_reservations")
}

/// Stock packet media attachments: photos, videos, certificate PDFs.
model StockMedia {
  id            Int      @id @default(autoincrement()) @db.UnsignedInt
  stockPacketId Int      @map("stock_packet_id") @db.UnsignedInt
  mediaType     String   @map("media_type") @db.VarChar(20) // PHOTO, VIDEO, CERTIFICATE
  filePath      String   @map("file_path") @db.VarChar(500)
  fileName      String   @map("file_name") @db.VarChar(255)
  fileSizeBytes Int?     @map("file_size_bytes") @db.UnsignedInt
  sortOrder     Int      @default(0) @map("sort_order") @db.UnsignedInt
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(3)

  // Relations
  stockPacket StockPacket @relation(fields: [stockPacketId], references: [id])

  @@index([stockPacketId], map: "IX_stock_media_packet")
  @@map("stock_media")
}

/// Physical stock verification batch records.
model StockAuditBatch {
  id              Int      @id @default(autoincrement()) @db.UnsignedInt
  companyId       Int      @map("company_id") @db.UnsignedInt
  batchNumber     String   @map("batch_number") @db.VarChar(30)
  auditDate       DateTime @map("audit_date") @db.Date
  status          String   @default("PENDING") @db.VarChar(20) // PENDING, IN_PROGRESS, COMPLETED
  totalPackets    Int      @default(0) @map("total_packets") @db.UnsignedInt
  matchedPackets  Int      @default(0) @map("matched_packets") @db.UnsignedInt
  mismatchPackets Int      @default(0) @map("mismatch_packets") @db.UnsignedInt
  remarks         String?  @db.Text
  conductedBy     Int?     @map("conducted_by") @db.UnsignedInt
  approvedBy      Int?     @map("approved_by") @db.UnsignedInt
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("stock_audit_batches")
}

