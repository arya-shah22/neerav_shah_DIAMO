// ═══════════════════════════════════════════════════════════════════════════════
// DIAMO ERP – ENTERPRISE DATABASE SCHEMA (Prisma ORM)
// ═══════════════════════════════════════════════════════════════════════════════
//
// Version:      1.0
// Tables:       48
// Database:     MySQL 8.0+
// ORM:          Prisma 5.x
// Architecture: Offline-first Desktop ERP (Electron + NestJS)
//
// ───────────────────────────────────────────────────────────────────────────────
// This schema implements the approved Enterprise Database Architecture Blueprint.
// All naming conventions, data types, precision levels, indexes, and
// relationships follow the blueprint specification exactly.
// ═══════════════════════════════════════════════════════════════════════════════

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextIndex"]
  binaryTargets   = ["native", "windows", "darwin", "darwin-arm64", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

