/// System error tracking log. Append-only.
model ErrorLog {
  id           Int      @id @default(autoincrement()) @db.UnsignedInt
  errorCode    String?  @map("error_code") @db.VarChar(30)
  errorMessage String   @map("error_message") @db.Text
  stackTrace   String?  @map("stack_trace") @db.Text
  moduleCode   String?  @map("module_code") @db.VarChar(50)
  userId       Int?     @map("user_id") @db.UnsignedInt
  hostname     String?  @db.VarChar(100)
  severity     String   @default("ERROR") @db.VarChar(20) // INFO, WARNING, ERROR, CRITICAL
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@index([severity, createdAt], map: "IX_error_logs_severity_date")
  @@map("error_logs")
}

