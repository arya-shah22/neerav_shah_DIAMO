model Loan {
  id                   Int                   @id @default(autoincrement()) @db.UnsignedInt
  companyId            Int                   @map("company_id") @db.UnsignedInt
  financialYearId      Int                   @map("financial_year_id") @db.UnsignedInt
  voucherNumber        String                @map("voucher_number") @db.VarChar(50)
  loanType             LoanType              @map("loan_type")
  partyId              Int                   @map("party_id") @db.UnsignedInt
  cashBankAccountId    Int                   @map("cash_bank_account_id") @db.UnsignedInt
  principalAmount      Decimal               @map("principal_amount") @db.Decimal(18, 2)
  interestRate         Decimal               @map("interest_rate") @db.Decimal(5, 2)
  interestType         InterestType          @map("interest_type")
  compoundingFrequency CompoundingFrequency? @map("compounding_frequency")
  durationMonths       Int                   @map("duration_months")
  loanDate             DateTime              @map("loan_date") @db.Date
  dueDate              DateTime?             @map("due_date") @db.Date
  status               LoanStatus            @default(ACTIVE)
  narration            String?               @db.Text
  totalInterest        Decimal               @default(0.00) @map("total_interest") @db.Decimal(18, 2)
  totalRepayable       Decimal               @default(0.00) @map("total_repayable") @db.Decimal(18, 2)
  amountRepaid         Decimal               @default(0.00) @map("amount_repaid") @db.Decimal(18, 2)
  balanceRemaining     Decimal               @default(0.00) @map("balance_remaining") @db.Decimal(18, 2)

  // Currency
  transactionCurrency  CurrencyCode          @default(INR) @map("transaction_currency")
  exchangeRate         Decimal               @default(1.0000) @map("exchange_rate") @db.Decimal(12, 4)
  principalAmountAlt   Decimal               @default(0.00) @map("principal_amount_alt") @db.Decimal(18, 2)

  // Audit
  createdBy Int?      @map("created_by") @db.UnsignedInt
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedBy Int?      @map("updated_by") @db.UnsignedInt
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedBy Int?      @map("deleted_by") @db.UnsignedInt
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)

  // Relations
  company         Company         @relation(fields: [companyId], references: [id])
  financialYear   FinancialYear   @relation(fields: [financialYearId], references: [id])
  party           Account         @relation("LoanPartyRelation", fields: [partyId], references: [id])
  cashBankAccount Account         @relation("LoanCashRelation", fields: [cashBankAccountId], references: [id])
  repayments      LoanRepayment[]

  @@unique([companyId, financialYearId, voucherNumber], map: "UQ_loans_number")
  @@index([companyId, loanDate], map: "IX_loans_date")
  @@map("loans")
}

model LoanRepayment {
  id                Int      @id @default(autoincrement()) @db.UnsignedInt
  loanId            Int      @map("loan_id") @db.UnsignedInt
  paymentDate       DateTime @map("payment_date") @db.Date
  amount            Decimal  @map("amount") @db.Decimal(18, 2)
  exchangeRate      Decimal  @default(1.0000) @map("exchange_rate") @db.Decimal(12, 4)
  amountAlt         Decimal  @default(0.00) @map("amount_alt") @db.Decimal(18, 2)
  cashBankAccountId Int      @map("cash_bank_account_id") @db.UnsignedInt
  narration         String?  @db.VarChar(255)
  createdBy         Int?     @map("created_by") @db.UnsignedInt
  createdAt         DateTime @default(now()) @map("created_at") @db.DateTime(3)

  // Relations
  loan            Loan    @relation(fields: [loanId], references: [id])
  cashBankAccount Account @relation(fields: [cashBankAccountId], references: [id])

  @@map("loan_repayments")
}

model AppNotification {
  id         Int      @id @default(autoincrement()) @db.UnsignedInt
  companyId  Int?     @map("company_id") @db.UnsignedInt
  userId     Int?     @map("user_id") @db.UnsignedInt
  title      String   @db.VarChar(255)
  message    String   @db.Text
  category   String   @default("SYSTEM") @db.VarChar(50) // RECEIVABLE, PAYABLE, STOCK, SYSTEM, USER, FINANCIAL
  priority   String   @default("MEDIUM") @db.VarChar(20) // CRITICAL, HIGH, MEDIUM, LOW, INFO
  targetPath String?  @map("target_path") @db.VarChar(255)
  isRead     Boolean  @default(false) @map("is_read")
  isResolved Boolean  @default(false) @map("is_resolved")
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@index([companyId, isRead], map: "IX_app_notifications_company_read")
  @@map("app_notifications")
}

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION: STOCK QUALITY TRANSFORMATION (Rough → Diamond Conversion)
// ═══════════════════════════════════════════════════════════════════════════════

/// Records a quality transformation event (e.g. Rough → Polished Diamond).
model StockConversion {
  id                Int      @id @default(autoincrement()) @db.UnsignedInt
  companyId         Int      @map("company_id") @db.UnsignedInt
  conversionDate    DateTime @map("conversion_date") @db.Date
  conversionNumber  String   @map("conversion_number") @db.VarChar(50)

  // Input (Source Rough Packet)
  sourcePacketId    Int      @map("source_packet_id") @db.UnsignedInt
  sourceQualityId   Int      @map("source_quality_id") @db.UnsignedInt
  sourceCarats      Decimal  @map("source_carats") @db.Decimal(12, 3)
  sourceCost        Decimal  @default(0.00) @map("source_cost") @db.Decimal(18, 2)

  // Consumption Mode
  isFullConsumption Boolean  @default(true) @map("is_full_consumption")
  consumedCarats    Decimal  @default(0.000) @map("consumed_carats") @db.Decimal(12, 3)
  remainingCarats   Decimal  @default(0.000) @map("remaining_carats") @db.Decimal(12, 3)

  // Job Work Reference (optional)
  jobVoucherId      Int?     @map("job_voucher_id") @db.UnsignedInt
  challanVoucherId  Int?     @map("challan_voucher_id") @db.UnsignedInt
  processingCost    Decimal  @default(0.00) @map("processing_cost") @db.Decimal(18, 2)

  // Yield Summary
  totalOutputCarats Decimal  @default(0.000) @map("total_output_carats") @db.Decimal(12, 3)
  weightLoss        Decimal  @default(0.000) @map("weight_loss") @db.Decimal(12, 3)
  lossPercentage    Decimal  @default(0.00) @map("loss_percentage") @db.Decimal(5, 2)

  narration         String?  @db.Text

  // Audit
  createdBy Int?     @map("created_by") @db.UnsignedInt
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  isDeleted Boolean  @default(false) @map("is_deleted")

  // Relations
  company       Company     @relation(fields: [companyId], references: [id])
  sourcePacket  StockPacket @relation("ConversionSource", fields: [sourcePacketId], references: [id])
  sourceQuality Quality     @relation("ConversionSourceQuality", fields: [sourceQualityId], references: [id])
  outputItems   StockConversionOutput[]

  @@index([companyId, conversionDate], map: "IX_stock_conversions_date")
  @@index([sourcePacketId], map: "IX_stock_conversions_source")
  @@map("stock_conversions")
}

/// Output line items of a stock conversion (each becomes a new StockPacket).
model StockConversionOutput {
  id                Int     @id @default(autoincrement()) @db.UnsignedInt
  stockConversionId Int     @map("stock_conversion_id") @db.UnsignedInt
  rowNumber         Int     @map("row_number") @db.UnsignedInt

  // Output Packet Reference
  outputPacketId    Int     @map("output_packet_id") @db.UnsignedInt
  outputQualityId   Int     @map("output_quality_id") @db.UnsignedInt

  // Physical Properties
  carats            Decimal @map("carats") @db.Decimal(12, 3)
  pieces            Int     @default(1) @db.UnsignedInt
  shape             String? @db.VarChar(30)
  color             String? @db.VarChar(30)
  clarity           String? @db.VarChar(30)
  cut               String? @db.VarChar(30)

  // Cost — manually entered by user
  costPerCarat      Decimal  @default(0.00) @map("cost_per_carat") @db.Decimal(18, 2)
  totalCost         Decimal  @default(0.00) @map("total_cost") @db.Decimal(18, 2)
  targetSaleRate    Decimal? @map("target_sale_rate") @db.Decimal(18, 2)
  remarks           String? @db.VarChar(255)

  // Relations
  stockConversion StockConversion @relation(fields: [stockConversionId], references: [id])
  outputPacket    StockPacket     @relation("ConversionOutput", fields: [outputPacketId], references: [id])
  outputQuality   Quality         @relation("ConversionOutputQuality", fields: [outputQualityId], references: [id])

  @@index([stockConversionId], map: "IX_stock_conversion_outputs_conv")
  @@map("stock_conversion_outputs")
}

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION: EXCHANGE RATE LOG (Multi-Currency Support)
// ═══════════════════════════════════════════════════════════════════════════════

/// Historical log of all exchange rates used in the system.
/// Every transaction that involves currency conversion logs its rate here.
/// Also serves as the source for "latest rate" pre-fill in forms.
model ExchangeRateLog {
  id                Int          @id @default(autoincrement()) @db.UnsignedInt
  companyId         Int          @map("company_id") @db.UnsignedInt
  rateDate          DateTime     @map("rate_date") @db.Date
  fromCurrency      CurrencyCode @default(USD) @map("from_currency")
  toCurrency        CurrencyCode @default(INR) @map("to_currency")
  exchangeRate      Decimal      @map("exchange_rate") @db.Decimal(12, 4)
  source            String       @default("MANUAL") @map("source") @db.VarChar(30) // MANUAL, TRANSACTION, SYSTEM

  // Reference to what triggered this entry
  sourceVoucherType String?      @map("source_voucher_type") @db.VarChar(30)
  sourceVoucherId   Int?         @map("source_voucher_id") @db.UnsignedInt

  remarks           String?      @db.VarChar(255)
  createdBy         Int?         @map("created_by") @db.UnsignedInt
  createdAt         DateTime     @default(now()) @map("created_at") @db.DateTime(3)

  // Relations
  company           Company      @relation(fields: [companyId], references: [id])

  @@index([companyId, rateDate], map: "IX_exchange_rate_log_date")
  @@index([companyId, fromCurrency, toCurrency, rateDate], map: "IX_exchange_rate_log_pair_date")
  @@map("exchange_rate_logs")
}
