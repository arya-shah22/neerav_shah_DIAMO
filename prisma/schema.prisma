  userId        Int      @unique @map("user_id") @db.UnsignedInt
  favoritePages Json?    @map("favorite_pages") // Array of page URIs
  quickActions  Json?    @map("quick_actions") // Array of action configs
  recentItems   Json?    @map("recent_items") // Array of recently accessed items
  pinnedReports Json?    @map("pinned_reports") // Array of saved report configs
  updatedAt     DateTime @updatedAt @map("updated_at") @db.DateTime(3)

