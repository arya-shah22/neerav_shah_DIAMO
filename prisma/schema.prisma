/// Voucher numbering format configuration per company + voucher type.
model VoucherNumberConfig {
  id              Int             @id @default(autoincrement()) @db.UnsignedInt
  companyId       Int             @map("company_id") @db.UnsignedInt
  financialYearId Int             @map("financial_year_id") @db.UnsignedInt
  voucherType     VoucherType     @map("voucher_type")
  method          NumberingMethod @default(AUTOMATIC)
  prefix          String?         @db.VarChar(20)
  separator       String          @default("-") @db.VarChar(5)
  suffix          String?         @db.VarChar(20)
  digitLength     Int             @default(6) @map("digit_length") @db.UnsignedInt
  includeYear     Boolean         @default(true) @map("include_year")
  includeMonth    Boolean         @default(false) @map("include_month")
  resetAnnually   Boolean         @default(true) @map("reset_annually")

  // Audit
  createdBy Int?     @map("created_by") @db.UnsignedInt
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedBy Int?     @map("updated_by") @db.UnsignedInt
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  // Relations
  company       Company       @relation(fields: [companyId], references: [id])
  financialYear FinancialYear @relation(fields: [financialYearId], references: [id])

  @@unique([companyId, financialYearId, voucherType], map: "UQ_voucher_number_configs")
  @@map("voucher_number_configs")
}

/// Running sequence counters per company + FY + voucher type.
model VoucherNumberSequence {
  id              Int         @id @default(autoincrement()) @db.UnsignedInt
  companyId       Int         @map("company_id") @db.UnsignedInt
  financialYearId Int         @map("financial_year_id") @db.UnsignedInt
  voucherType     VoucherType @map("voucher_type")
  currentNumber   Int         @default(0) @map("current_number") @db.UnsignedInt
  lastGeneratedAt DateTime?   @map("last_generated_at") @db.DateTime(3)

  // Relations
  company       Company       @relation(fields: [companyId], references: [id])
  financialYear FinancialYear @relation(fields: [financialYearId], references: [id])

  @@unique([companyId, financialYearId, voucherType], map: "UQ_voucher_number_sequences")
  @@map("voucher_number_sequences")
}

/// Key-value system settings per company.
model SystemSetting {
  id           Int      @id @default(autoincrement()) @db.UnsignedInt
  companyId    Int      @map("company_id") @db.UnsignedInt
  settingKey   String   @map("setting_key") @db.VarChar(100)
  settingValue Json?    @map("setting_value")
  category     String?  @db.VarChar(50)
  description  String?  @db.VarChar(255)
  updatedBy    Int?     @map("updated_by") @db.UnsignedInt
  updatedAt    DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  // Relations
  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, settingKey], map: "UQ_system_settings_key")
  @@map("system_settings")
}

/// Print template layout configurations per company + voucher type.
model PrintTemplate {
  id           Int         @id @default(autoincrement()) @db.UnsignedInt
  companyId    Int         @map("company_id") @db.UnsignedInt
  voucherType  VoucherType @map("voucher_type")
  templateName String      @map("template_name") @db.VarChar(100)
  isDefault    Boolean     @default(false) @map("is_default")
  layoutConfig Json?       @map("layout_config")
  headerHtml   String?     @map("header_html") @db.Text
  footerHtml   String?     @map("footer_html") @db.Text
  paperSize    String      @default("A4") @map("paper_size") @db.VarChar(10)
  orientation  String      @default("portrait") @db.VarChar(10)
  createdAt    DateTime    @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.DateTime(3)

  // Relations
  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, voucherType], map: "IX_print_templates_company_type")
  @@map("print_templates")
}

/// Backup execution history with file references and checksums.
model BackupRecord {
  id            Int      @id @default(autoincrement()) @db.UnsignedInt
  backupType    String   @map("backup_type") @db.VarChar(20) // FULL, INCREMENTAL, MANUAL
  filePath      String   @map("file_path") @db.VarChar(500)
  fileName      String   @map("file_name") @db.VarChar(255)
  fileSizeBytes BigInt?  @map("file_size_bytes")
  checksum      String?  @db.VarChar(64) // SHA-256
  status        String   @default("COMPLETED") @db.VarChar(20)
  durationMs    Int?     @map("duration_ms") @db.UnsignedInt
  initiatedBy   Int?     @map("initiated_by") @db.UnsignedInt
  remarks       String?  @db.VarChar(255)
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@index([createdAt], map: "IX_backup_records_date")
  @@map("backup_records")
}

