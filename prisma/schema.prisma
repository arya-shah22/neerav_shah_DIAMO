/// User dashboard widget personalization.
model DashboardWidget {
  id          Int        @id @default(autoincrement()) @db.UnsignedInt
  userId      Int        @map("user_id") @db.UnsignedInt
  widgetType  WidgetType @map("widget_type")
  widgetTitle String     @map("widget_title") @db.VarChar(100)
  dataSource  String     @map("data_source") @db.VarChar(100) // e.g., 'sales_today', 'outstanding_receivables'
  position    Int        @default(0) @db.UnsignedInt
  columnSpan  Int        @default(1) @map("column_span") @db.UnsignedInt
