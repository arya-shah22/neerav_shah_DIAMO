/// Immutable system-wide change log. NO UPDATE or DELETE allowed.
model AuditLog {
  id             BigInt      @id @default(autoincrement())
  companyId      Int?        @map("company_id") @db.UnsignedInt
  entityType     String      @map("entity_type") @db.VarChar(50)
  entityId       Int         @map("entity_id") @db.UnsignedInt
  action         AuditAction
  beforeValue    Json?       @map("before_value")
  afterValue     Json?       @map("after_value")
  changedFields  Json?       @map("changed_fields")
  userId         Int         @map("user_id") @db.UnsignedInt
  ipAddress      String?     @map("ip_address") @db.VarChar(45)
  hostname       String?     @db.VarChar(100)
  overrideReason String?     @map("override_reason") @db.Text
  createdAt      DateTime    @default(now()) @map("created_at") @db.DateTime(3)

  @@index([entityType, entityId], map: "IX_audit_logs_entity")
  @@index([companyId, createdAt], map: "IX_audit_logs_company_date")
  @@index([userId, createdAt], map: "IX_audit_logs_user_date")
  @@map("audit_logs")
}

model ReportValidationLog {
  id             Int      @id @default(autoincrement()) @db.UnsignedInt
  companyId      Int      @map("company_id") @db.UnsignedInt
  validationDate DateTime @default(now()) @map("validation_date")
  checkType      String   @map("check_type") @db.VarChar(50)
  status         String   @map("status") @db.VarChar(20)
  summary        String   @map("summary") @db.VarChar(255)
  detailsJson    String   @map("details_json") @db.LongText
  certifiedBy    String   @map("certified_by") @db.VarChar(50)
  certificateNo  String   @unique @map("certificate_no") @db.VarChar(50)
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([companyId, validationDate], map: "IX_report_validation_company_date")
  @@map("report_validation_logs")
}

/// User-facing notification/alert records.
model NotificationRecord {
  id               Int                  @id @default(autoincrement()) @db.UnsignedInt
  companyId        Int                  @map("company_id") @db.UnsignedInt
  userId           Int                  @map("user_id") @db.UnsignedInt
  notificationType NotificationType     @map("notification_type")
  priority         NotificationPriority @default(MEDIUM)
  title            String               @db.VarChar(150)
  message          String               @db.Text
  isRead           Boolean              @default(false) @map("is_read")
  readAt           DateTime?            @map("read_at") @db.DateTime(3)
