// SECTION 8: SECURITY & ADMINISTRATION TABLES (8)
// ═══════════════════════════════════════════════════════════════════════════════

/// Staff user accounts with authentication credentials and profile details.
model User {
  id                   Int        @id @default(autoincrement()) @db.UnsignedInt
  userIdHandle         String     @unique @map("user_id_handle") @db.VarChar(50)
  passwordHash         String     @map("password_hash") @db.VarChar(255)
  fullName             String     @map("full_name") @db.VarChar(150)
  // length: 250 caps the unique index at 1000 bytes (utf8mb4) so MySQL 9.x / MariaDB
  // accept it; the column itself stays VARCHAR(255). See IX_stock_packets_physical.
  email                String     @unique(length: 250) @db.VarChar(255)
  mobile               String?    @db.VarChar(20)
  designation          String?    @db.VarChar(100)
  profilePicturePath   String?    @map("profile_picture_path") @db.VarChar(500)
  isSuperAdmin         Boolean    @default(false) @map("is_super_admin")
  status               UserStatus @default(ACTIVE)
  permissionTemplateId Int?       @map("permission_template_id") @db.UnsignedInt
  failedLoginAttempts  Int        @default(0) @map("failed_login_attempts") @db.UnsignedInt
  lastLoginAt          DateTime?  @map("last_login_at") @db.DateTime(3)
  lastPasswordChange   DateTime?  @map("last_password_change") @db.DateTime(3)

  employeeCode         String?    @unique @map("employee_code") @db.VarChar(50)
  department           String?    @db.VarChar(100)
  remarks              String?    @db.VarChar(255)

  // Audit
  createdBy Int?      @map("created_by") @db.UnsignedInt
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedBy Int?      @map("updated_by") @db.UnsignedInt
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedBy Int?      @map("deleted_by") @db.UnsignedInt
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)
  version   Int       @default(1) @db.UnsignedInt

  // Relations
  permissionTemplate PermissionTemplate?  @relation(fields: [permissionTemplateId], references: [id])
  companyAccess      UserCompanyAccess[]
  sessions           UserSession[]
  activityLogs       ActivityLog[]
  loginHistory       LoginHistory[]
  notifications      NotificationRecord[]
  dashboardWidgets   DashboardWidget[]
  workspace          UserWorkspace?
  pagePermissions    PagePermission[]     @relation("UserPagePerms")
  modulePermissions  ModulePermission[]   @relation("UserModulePerms")

  @@map("users")
}

/// Company-level access grants per user.
model UserCompanyAccess {
  id        Int      @id @default(autoincrement()) @db.UnsignedInt
  userId    Int      @map("user_id") @db.UnsignedInt
  companyId Int      @map("company_id") @db.UnsignedInt
  isDefault Boolean  @default(false) @map("is_default")
  grantedAt DateTime @default(now()) @map("granted_at") @db.DateTime(3)
  grantedBy Int?     @map("granted_by") @db.UnsignedInt

  // Relations
  user    User    @relation(fields: [userId], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  @@unique([userId, companyId], map: "UQ_user_company_access")
  @@map("user_company_access")
}

/// Active login session tracking.
model UserSession {
  id             Int       @id @default(autoincrement()) @db.UnsignedInt
  userId         Int       @map("user_id") @db.UnsignedInt
  sessionToken   String    @unique(length: 250) @map("session_token") @db.VarChar(255)
  hostname       String?   @db.VarChar(100)
  ipAddress      String?   @map("ip_address") @db.VarChar(45)
  loginAt        DateTime  @default(now()) @map("login_at") @db.DateTime(3)
  lastActivityAt DateTime? @map("last_activity_at") @db.DateTime(3)
  logoutAt       DateTime? @map("logout_at") @db.DateTime(3)
  isActive       Boolean   @default(true) @map("is_active")

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@index([userId, isActive], map: "IX_user_sessions_active")
  @@map("user_sessions")
}

/// Predefined role/permission profiles.
model PermissionTemplate {
  id           Int     @id @default(autoincrement()) @db.UnsignedInt
  templateName String  @map("template_name") @db.VarChar(100)
  description  String? @db.VarChar(255)
  companyId    Int?    @map("company_id") @db.UnsignedInt // Nullable for global templates

  // Audit
  createdBy Int?     @map("created_by") @db.UnsignedInt
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedBy Int?     @map("updated_by") @db.UnsignedInt
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  isDeleted Boolean  @default(false) @map("is_deleted")
  version   Int      @default(1) @db.UnsignedInt

  // Relations
  users             User[]
  pagePermissions   PagePermission[]   @relation("TemplatePagePerms")
  modulePermissions ModulePermission[] @relation("TemplateModulePerms")

  @@map("permission_templates")
}

/// Page/menu visibility control per user or template.
model PagePermission {
  id                   Int     @id @default(autoincrement()) @db.UnsignedInt
  userId               Int?    @map("user_id") @db.UnsignedInt
  permissionTemplateId Int?    @map("permission_template_id") @db.UnsignedInt
  pageUri              String  @map("page_uri") @db.VarChar(100)
  canView              Boolean @default(false) @map("can_view")

  // Relations
  user               User?               @relation("UserPagePerms", fields: [userId], references: [id])
  permissionTemplate PermissionTemplate? @relation("TemplatePagePerms", fields: [permissionTemplateId], references: [id])

  @@index([userId], map: "IX_page_permissions_user")
  @@index([permissionTemplateId], map: "IX_page_permissions_template")
  @@map("page_permissions")
}

/// Action-level CRUD controls per user or template.
model ModulePermission {
  id                   Int     @id @default(autoincrement()) @db.UnsignedInt
  userId               Int?    @map("user_id") @db.UnsignedInt
  permissionTemplateId Int?    @map("permission_template_id") @db.UnsignedInt
  moduleCode           String  @map("module_code") @db.VarChar(50) // e.g., 'sale_book', 'quality_master'
  actionCode           String  @map("action_code") @db.VarChar(50) // e.g., 'create', 'edit', 'delete', 'export'
  isAllowed            Boolean @default(false) @map("is_allowed")

  // Relations
  user               User?               @relation("UserModulePerms", fields: [userId], references: [id])
  permissionTemplate PermissionTemplate? @relation("TemplateModulePerms", fields: [permissionTemplateId], references: [id])

  @@index([userId], map: "IX_module_permissions_user")
  @@index([permissionTemplateId], map: "IX_module_permissions_template")
  @@map("module_permissions")
}

/// User activity event tracking. Append-only.
model ActivityLog {
  id          Int      @id @default(autoincrement()) @db.UnsignedInt
  userId      Int?     @map("user_id") @db.UnsignedInt
  action      String   @db.VarChar(50)
  moduleCode  String?  @map("module_code") @db.VarChar(50)
  entityType  String?  @map("entity_type") @db.VarChar(50)
  entityId    Int?     @map("entity_id") @db.UnsignedInt
  description String?  @db.VarChar(500)
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)

  // Relations
  user User? @relation(fields: [userId], references: [id])

  @@index([userId, createdAt], map: "IX_activity_logs_user_date")
  @@index([entityType, entityId], map: "IX_activity_logs_entity")
  @@map("activity_logs")
}

/// Login/logout timestamps and device details. Append-only.
model LoginHistory {
  id         Int      @id @default(autoincrement()) @db.UnsignedInt
  userId     Int      @map("user_id") @db.UnsignedInt
  action     String   @db.VarChar(10) // LOGIN, LOGOUT, FAILED
  hostname   String?  @db.VarChar(100)
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.VarChar(255)
  failReason String?  @map("fail_reason") @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt], map: "IX_login_history_user_date")
  @@map("login_history")
}

